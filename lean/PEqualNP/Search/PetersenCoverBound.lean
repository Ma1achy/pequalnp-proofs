import Mathlib.Data.Finset.Card
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic

namespace PEqualNP.Search.PetersenCoverBound

abbrev V := Fin 9

/-- The twelve edges of the Petersen-minus-a-vertex instance of L-meta-2150
and L-meta-2152, each written once with the smaller endpoint first. -/
def edges : Finset (V × V) :=
  {(0,1),(1,2),(2,3),(3,4),(0,4),(0,5),(1,6),(2,7),(3,8),(5,7),(6,8),(5,8)}

def edgePair (i j : V) : V × V := (min i j,max i j)

def Adj (i j : V) : Prop := edgePair i j ∈ edges

instance (i j : V) : Decidable (Adj i j) := inferInstanceAs (Decidable (_ ∈ edges))

theorem edge_count : edges.card = 12 := by decide

private theorem codegree : ∀ i j : V, i ≠ j →
    (Finset.univ.filter (fun v : V => Adj i v ∧ Adj j v)).card ≤ 1 := by decide

/-- No nonempty sound biclique has two vertices in each part. -/
theorem biclique_is_star (A B : Finset V) (ha : A.Nonempty) (hb : B.Nonempty)
    (sound : ∀ i ∈ A, ∀ j ∈ B, Adj i j) : A.card = 1 ∨ B.card = 1 := by
  by_cases small : A.card ≤ 1
  · exact Or.inl (by have := Finset.card_pos.mpr ha; omega)
  · obtain ⟨i,hi,j,hj,diff⟩ := Finset.one_lt_card.mp (Nat.lt_of_not_ge small)
    have sub : B ⊆ Finset.univ.filter (fun v : V => Adj i v ∧ Adj j v) := by
      intro v hv
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,sound i hi v hv,sound j hj v hv⟩
    have bound := (Finset.card_le_card sub).trans (codegree i j diff)
    exact Or.inr (by have := Finset.card_pos.mpr hb; omega)

def IsCover (C : Finset V) : Prop := ∀ e ∈ edges, e.1 ∈ C ∨ e.2 ∈ C

/-- The outer 5-cycle costs at least three vertices, and the two disjoint
remaining edges (5,7) and (6,8) cost two more. -/
theorem cover_lower (C : Finset V) (hc : IsCover C) : 5 ≤ C.card := by
  let hit (v : V) : ℕ := if v ∈ C then 1 else 0
  have edge (i j : V) (e : (i,j) ∈ edges) : 1 ≤ hit i + hit j := by
    rcases hc _ e with hi | hj
    · simp [hit,hi]
    · simp [hit,hj]
  have h01 := edge 0 1 (by decide)
  have h12 := edge 1 2 (by decide)
  have h23 := edge 2 3 (by decide)
  have h34 := edge 3 4 (by decide)
  have h04 := edge 0 4 (by decide)
  have h57 := edge 5 7 (by decide)
  have h68 := edge 6 8 (by decide)
  have total : (∑ i : Fin 9, hit i) = C.card := by simp [hit]
  norm_num [Fin.sum_univ_succ] at total
  omega

theorem cover_exact : ∃ C : Finset V, IsCover C ∧ C.card = 5 := by
  exact ⟨{0,2,3,5,6}, by unfold IsCover; decide, by decide⟩

/-- One star term computes x_c AND the OR of its leaves. -/
def starEdges (c : V) (L : Finset V) : Finset (V × V) := L.image (edgePair c)

def StarCover {k : ℕ} (center : Fin k → V) (leaves : Fin k → Finset V) : Prop :=
  (∀ t, (leaves t).Nonempty) ∧
    Finset.univ.biUnion (fun t => starEdges (center t) (leaves t)) = edges

/-- Unshared fan-in-two gate cost: a star with d≥1 leaves uses d gates, and
the OR combining k≥1 disjoint term circuits uses k−1 gates. -/
def starCost {k : ℕ} (leaves : Fin k → Finset V) : ℕ :=
  (∑ t, (leaves t).card) + (k-1)

theorem star_cost_lower {k : ℕ} (center : Fin k → V) (leaves : Fin k → Finset V)
    (cover : StarCover center leaves) : 16 ≤ starCost leaves := by
  have ht : IsCover (Finset.univ.image center) := by
    intro e he
    rw [← cover.2] at he
    obtain ⟨t,_,z⟩ := Finset.mem_biUnion.mp he
    obtain ⟨v,_,rfl⟩ := Finset.mem_image.mp z
    by_cases h : center t ≤ v
    · exact Or.inl (by simp [edgePair,min_eq_left h])
    · exact Or.inr (by simp [edgePair,max_eq_left (le_of_not_ge h)])
  have kbound := (cover_lower _ ht).trans (Finset.card_image_le.trans_eq (Finset.card_fin k))
  have count : 12 ≤ ∑ t, (leaves t).card := by
    rw [← edge_count, ← cover.2]
    apply Finset.card_biUnion_le.trans
    exact Finset.sum_le_sum (fun _ _ => Finset.card_image_le)
  unfold starCost
  omega

/-- Undirected pairs generated by the term (OR A) AND (OR B). -/
def bicliqueEdges (A B : Finset V) : Finset (V × V) :=
  (A ×ˢ B).image (fun z => edgePair z.1 z.2)

private theorem edgePair_comm (x y : V) : edgePair x y = edgePair y x := by
  simp [edgePair,min_comm,max_comm]

/-- The same lower bound applies directly to unshared ORs of arbitrary sound
biclique factors. Each factor must reduce to a star on this graph. -/
theorem biclique_formula_cost_lower {k : ℕ} (A B : Fin k → Finset V)
    (ha : ∀ t, (A t).Nonempty) (hb : ∀ t, (B t).Nonempty)
    (complete : Finset.univ.biUnion (fun t => bicliqueEdges (A t) (B t)) = edges) :
    16 ≤ (∑ t, (((A t).card - 1) + ((B t).card - 1) + 1)) + (k-1) := by
  classical
  have norm (t : Fin k) : ∃ (c : V) (L : Finset V), L.Nonempty ∧
      starEdges c L = bicliqueEdges (A t) (B t) ∧
      L.card = (A t).card - 1 + ((B t).card - 1) + 1 := by
    have sound (i : V) (hi : i ∈ A t) (j : V) (hj : j ∈ B t) : Adj i j := by
      unfold Adj
      rw [← complete]
      apply Finset.mem_biUnion.mpr
      exact ⟨t,Finset.mem_univ _,Finset.mem_image.mpr ⟨(i,j),Finset.mem_product.mpr ⟨hi,hj⟩,rfl⟩⟩
    rcases biclique_is_star _ _ (ha t) (hb t) sound with one | one
    · obtain ⟨c,hc⟩ := Finset.card_eq_one.mp one
      refine ⟨c,B t,hb t,?_,?_⟩
      · ext e
        simp [starEdges,bicliqueEdges,hc]
      · have := Finset.card_pos.mpr (hb t); omega
    · obtain ⟨c,hc⟩ := Finset.card_eq_one.mp one
      refine ⟨c,A t,ha t,?_,?_⟩
      · ext e
        simp [starEdges,bicliqueEdges,hc,edgePair_comm c]
      · have := Finset.card_pos.mpr (ha t); omega
  choose c L ne rep cost using norm
  have cover : StarCover c L := ⟨ne,by simpa only [rep] using complete⟩
  simpa only [starCost,cost] using star_cost_lower c L cover

/-- The restricted lower bound is attained by five explicit stars. -/
theorem star_cost_exact : ∃ (center : Fin 5 → V) (leaves : Fin 5 → Finset V),
    StarCover center leaves ∧ starCost leaves = 16 := by
  let center : Fin 5 → V := ![0,2,3,5,6]
  let leaves : Fin 5 → Finset V := ![{1,4,5},{1,3,7},{4,8},{7,8},{1,8}]
  exact ⟨center,leaves,by dsimp [StarCover,center,leaves]; decide,by dsimp [starCost,leaves]; decide⟩

theorem no_common_neighbor_04 : ∀ c : V, ¬ (Adj c 0 ∧ Adj c 4) := by decide

/-- The first-gate pair from the held statements cannot lie together in the
leaf set of any star whose edges belong to this graph. -/
theorem first_or_outside_star {k : ℕ} (center : Fin k → V) (leaves : Fin k → Finset V)
    (cover : StarCover center leaves) (t : Fin k) : ¬ (0 ∈ leaves t ∧ 4 ∈ leaves t) := by
  rintro ⟨h0,h4⟩
  have adj (v : V) (hv : v ∈ leaves t) : Adj (center t) v := by
    unfold Adj
    rw [← cover.2]
    exact Finset.mem_biUnion.mpr ⟨t,Finset.mem_univ _,Finset.mem_image_of_mem _ hv⟩
  exact no_common_neighbor_04 _ ⟨adj _ h0,adj _ h4⟩

end PEqualNP.Search.PetersenCoverBound
