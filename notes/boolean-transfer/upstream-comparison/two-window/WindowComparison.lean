  ∀ (n m : ℕ) (S : Fin m → Finset (Fin n)) (C : PEqualNP.CircuitLowerBounds.Circuit) (o : Fin m → ℕ) (t : ℕ) (y : Finset (Fin n)), (∀ a1 a2 : Fin m, a1 ≠ a2 → (S a1 ∩ S a2).card ≤ 1) → (∀ e1 ∈ C.gates, (e1.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ e1.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ e1.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ e1.inputs.length ≤ 2) → (∀ l1 : Fin C.gates.length, (C.gates.get l1).op = PEqualNP.CircuitLowerBounds.GateOp.not → (l1 : ℕ) = t) → (∀ (a3 : Fin m) (z1 : Fin n → Bool), (C.wires (List.ofFn z1)).getD (o a3) false = decide (∃ s1 ∈ S a3, z1 s1 = true)) → (∀ z2 : Fin n → Bool, (Finset.univ.filter (fun v1 : Fin n => z2 v1 = true)).card < y.card → (C.wires (List.ofFn z2)).getD (n + t) false = true) → (C.wires (List.ofFn (fun v2 : Fin n => decide (v2 ∈ y)))).getD (n + t) false = false → (2 ≤ y.card → ∀ i1 : Fin m, ¬ Disjoint (S i1) y → min y.card (S i1).card ≤ (Finset.univ.filter (fun g1 : Fin C.gates.length => (∀ p1 : Fin n, (C.wires (List.ofFn (fun v3 : Fin n => decide (v3 = p1)))).getD (n + g1) false = true → p1 ∈ S i1) ∧ 2 ≤ (Finset.univ.filter (fun p2 : Fin n => (C.wires (List.ofFn (fun v4 : Fin n => decide (v4 = p2)))).getD (n + g1) false = true)).card)).card + 1) → (∀ i2 : Fin m, Disjoint (S i2) y → (S i2).card ≤ (Finset.univ.filter (fun g2 : Fin C.gates.length => (∀ p3 : Fin n, p3 ∉ y → (C.wires (List.ofFn (fun v5 : Fin n => decide (v5 ∈ y ∨ v5 = p3)))).getD (n + g2) false = true → p3 ∈ S i2) ∧ 2 ≤ (Finset.univ.filter (fun p4 : Fin n => p4 ∉ y ∧ (C.wires (List.ofFn (fun v6 : Fin n => decide (v6 ∈ y ∨ v6 = p4)))).getD (n + g2) false = true)).card)).card + 1) → (∑ i0 : Fin m, if Disjoint (S i0) y then (S i0).card else min y.card (S i0).card) ≤ C.gates.length + (Finset.univ.filter (fun g0 : Fin C.gates.length => (∃ i5 : Fin m, ∀ p6 : Fin n, (C.wires (List.ofFn (fun v8 : Fin n => decide (v8 = p6)))).getD (n + g0) false = true ↔ p6 ∈ S i5) ∧ (∃ i6 : Fin m, Disjoint (S i6) y ∧ ∀ p7 : Fin n, p7 ∉ y → ((C.wires (List.ofFn (fun v9 : Fin n => decide (v9 ∈ y ∨ v9 = p7)))).getD (n + g0) false = true ↔ p7 ∈ S i6)))).card + m

theorem equivalence (charge : G270) (mono : G529) (normalize : G669)
    (light : G1594) (heavy : G1595) : G997 ↔ G1596 := by
  constructor
  · intro h n m S C o t y hS hg hn ho ht hy _ _
    exact h n m S C o t y hS hg hn ho ht hy
  · intro h n m S C o t y hS hg hn ho ht hy
    apply h n m S C o t y hS hg hn ho ht hy
    · intro hcard i _
      exact light normalize charge n m S C o t y hS hg hn ho ht hy hcard i
    · exact heavy normalize mono n m S C o t y hS hg hn ho ht hy

end
end WindowComparison
